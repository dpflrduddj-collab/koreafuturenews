# GEMINI_API_KEY: Google Gemini API 키 (기사 요약, AI 초안 작성, 3대 핵심 포인트 추출)
# AI Studio Secrets 또는 환경 변수로 주입됩니다.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: 서비스 호스팅 URL (배포 환경)
APP_URL="MY_APP_URL"

# ADMIN_KEY: RSS 관리자 및 기사 편집 데스크 접근 인증 키 (기본값: admin2026)
ADMIN_KEY="admin2026"
ADMIN_SECRET_KEY="admin2026"

# RSS_REFRESH_INTERVAL_MINUTES: RSS 백그라운드 수집 주기 (기본값: 15분)
RSS_REFRESH_INTERVAL_MINUTES="15"

